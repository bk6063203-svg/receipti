# Optional: cross-device sync for the Live Transaction Demo (Supabase Realtime broadcast).
# Without these, the demo runs in same-browser mode (split screen + tabs on this device stay in sync).
# No tables or SQL needed — the transaction publishes over a broadcast channel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Database: run supabase/migrations/0001_live_receipts.sql in the Supabase SQL editor.
